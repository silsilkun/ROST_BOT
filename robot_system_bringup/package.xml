  <version>0.0.0</version>
  <description>System bringup launch package for Doosan + control + estimation.</description>
  <maintainer email="2001sonickim@gmail.comm">eipih</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
